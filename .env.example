# Supabase project credentials (Settings > API in the Supabase dashboard).
# Point these at your DEV project for local testing; production hosting
# keeps its own values pointing at the production project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Amplitude project API key (Settings > Projects in the Amplitude dashboard).
# Use a separate Amplitude project for dev and for production.
#
# The project MUST live in Amplitude's EU region: the SDK is initialised with
# serverZone 'EU' (see src/lib/analytics.ts), and a key from a US-region
# project is rejected against the EU endpoint with a misleading
# "Invalid API key" error. Region is chosen when the project/org is created
# and cannot be changed afterwards.
#
# NOTE: Vite inlines VITE_* variables at BUILD time, not runtime. Production
# hosting must expose this during `npm run build`, not just as a runtime env
# var — otherwise the bundle ships an empty key and analytics is silently
# disabled (no error). Verify events arrive after deploying.
#
# Leave unset to disable analytics (e.g. in local dev).
VITE_AMPLITUDE_API_KEY=your-amplitude-api-key-here

# Cloudflare Turnstile site key (public), checked before emailing a sign-in code.
# The secret key goes in Supabase (Authentication > Attack Protection), never here.
# Built in at BUILD time like the keys above. Leave unset to hide the widget, which
# only works while captcha protection is off in that Supabase project. See SETUP.md.
VITE_TURNSTILE_SITE_KEY=
